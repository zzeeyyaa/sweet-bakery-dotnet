@model List<SweetBakeryApp.Models.MenuItem>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sweet Bakery - Daftar Menu</title>
    <style>
            body {
                font-family: 'Sagoe UI', sans-serif;
                margin: 40px;
                background-color: #fdfbf7;
            }

            h1 {
                color: #884513;
            }

            table {
                width: 100%;
                max-width: 600px;
                border-collapse: collapse;
                background: white;
                box-shadow: 0 4px6px rgba(0, 0, 0, 1);
                border-radius: 8px;
                overflow: hidden;
            }

            th,
            td {
                padding: 12px 16px;
                text-align: left;
                border-bottom: 1px solid #eee;
            }

            th {
                background-color: #f4a261;
                color: white;
            }

            tr:hover {
                background-color: #fffaf0;
            }
    </style>
</head>

<body>
    <h1>Sweet Bakery Menu</h1>
    <table>
        <thead>
            <tr>
                <th>Nama Kue</th>
                <th>Harga</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>Rp@item.Price.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</body>

</html>