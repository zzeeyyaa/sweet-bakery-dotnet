@page "/cashier"
@inject MenuService MenuService
@inject CashierService CashierService

<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6">
    <!-- Navigasi -->
    @* <div class="flex gap-4 mb-6">
        <a href="/" class="text-stone-500 hover:text-amber-800 font-medium">📋 Menu Admin</a>
        <a href="/cashier" class="text-amber-800 font-bold border-b-2 border-amber-600 pb-1">🛒 Kasir (POS)</a>
        <a href="/kitchen" class="text-stone-500 hover:text-amber-800 font-medium">👨‍🍳 Layar Dapur</a>
    </div> *@

    <h1 class="text-2xl font-bold text-amber-900 mb-6">Kasir - Buat Pesanan Baru</h1>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="mb-4 p-4 rounded-xl bg-green-100 text-green-800 border border-green-200">
            @alertMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Pilihan Menu -->
        <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-amber-100">
            <h2 class="text-lg font-bold text-stone-800 mb-4">Pilih Item Menu</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @foreach (var item in availableMenus)
                {
                    <div
                        class="border border-stone-200 p-4 rounded-xl flex justify-between items-center hover:border-amber-400 transition-colors">
                        <div>
                            <p class="font-bold text-stone-800">@item.Name</p>
                            <p class="text-sm text-amber-700 font-semibold">Rp@(item.Price.ToString("N0"))</p>
                        </div>
                        <button @onclick="() => AddToCart(item)"
                                class="bg-amber-100 hover:bg-amber-200 text-amber-900 px-3 py-1.5 rounded-lg text-sm font-semibold transition">
                            + Tambah
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Ringkasan Keranjang (OrderTicket) -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-amber-100 flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold text-stone-800 mb-4">Keranjang Pesanan</h2>

                @if (!cart.Any())
                {
                    <p class="text-sm text-stone-400 py-6 text-center">Keranjang masih kosong.</p>
                }
                else
                {
                    <div class="space-y-3 max-h-60 overflow-y-auto pr-1">
                        @foreach (var ticket in cart)
                        {
                            <div class="flex justify-between items-center text-sm border-b pb-2">
                                <div>
                                    <p class="font-medium text-stone-800">@ticket.Item.Name</p>
                                    <p class="text-xs text-stone-500">@ticket.Quantity x Rp@(ticket.Item.Price.ToString("N0"))
                                    </p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-stone-800">Rp@(ticket.TotalPrice.ToString("N0"))</span>
                                    <button @onclick="() => RemoveFromCart(ticket)"
                                            class="text-red-500 hover:text-red-700 text-xs font-bold">✕</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4 pt-4 border-t border-stone-200 flex justify-between items-center">
                        <span class="font-bold text-stone-700">Total:</span>
                        <span class="text-xl font-extrabold text-amber-900">
                            Rp@(cart.Sum(x => x.TotalPrice).ToString("N0"))
                        </span>
                    </div>
                }
            </div>

            <button @onclick="SubmitOrder" disabled="@(!cart.Any())"
                    class="mt-6 w-full bg-amber-600 hover:bg-amber-700 disabled:bg-stone-300 text-white font-bold py-3 rounded-xl transition shadow">
                Kirim ke Dapur 🚀
            </button>
        </div>
    </div>
</div>

@code {
    private List<MenuItem> availableMenus = new();
    private List<OrderTicket> cart = new();
    private string alertMessage = string.Empty;

    protected override void OnInitialized()
    {
        availableMenus = MenuService.GetAllMenu();
    }

    private void AddToCart(MenuItem item)
    {
        var existing = cart.FirstOrDefault(x => x.MenuItemId == item.Id);
        if (existing != null)
        {
            existing.Quantity++;
        }
        else
        {
            cart.Add(new OrderTicket(item, 1));
        }
    }

    private void RemoveFromCart(OrderTicket ticket)
    {
        cart.Remove(ticket);
    }

    private void SubmitOrder()
    {
        if (!cart.Any()) return;

        foreach (var ticket in cart)
        {
            CashierService.CreateOrder(ticket.Item, ticket.Quantity);
        }

        alertMessage = "Pesanan berhasil dibuat dan diteruskan ke bagian dapur!";
        cart.Clear();
    }
}