@page "/kitchen"
@inject KitchenService KitchenService

<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6">
    <!-- Navigasi -->
    @* <div class="flex gap-4 mb-6">
        <a href="/" class="text-stone-500 hover:text-amber-800 font-medium">📋 Menu Admin</a>
        <a href="/cashier" class="text-stone-500 hover:text-amber-800 font-medium">🛒 Kasir (POS)</a>
        <a href="/kitchen" class="text-amber-800 font-bold border-b-2 border-amber-600 pb-1">👨‍🍳 Layar Dapur</a>
    </div> *@

    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-amber-900">Antrean Dapur (Live Orders)</h1>
        <button @onclick="LoadOrders"
                class="bg-amber-100 hover:bg-amber-200 text-amber-900 text-sm font-semibold px-4 py-2 rounded-xl transition">
            🔄 Refresh Antrean
        </button>
    </div>

    @if (activeOrders == null || !activeOrders.Any())
    {
        <div class="bg-white p-12 rounded-2xl shadow-sm text-center border border-amber-100">
            <span class="text-4xl">☕</span>
            <p class="mt-2 text-stone-500 font-medium">Tidak ada antrean pesanan aktif saat ini.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var ticket in activeOrders)
            {
                <div class="bg-white rounded-2xl border border-amber-100 shadow-sm p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-xs font-bold text-amber-800 bg-amber-100 px-2 py-1 rounded-md">
                                #@ticket.Id.ToString().Substring(0, 8)
                            </span>
                            <span
                                class="text-xs font-bold px-2 py-1 rounded-md @(ticket.Status == OrderStatus.Pending ? "bg-yellow-100 text-yellow-800" : "bg-blue-100 text-blue-800")">
                                @ticket.Status
                            </span>
                        </div>

                        <div class="my-4">
                            <p class="text-base font-bold text-stone-800">@ticket.Item?.Name</p>
                            <p class="text-sm text-stone-600">Jumlah: <span
                                class="font-bold text-amber-900">@ticket.Quantity</span></p>
                                <p class="text-xs text-stone-500 mt-1">Total: Rp@(ticket.TotalPrice.ToString("N0"))</p>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-t border-stone-100">
                            @if (ticket.Status == OrderStatus.Pending)
                            {
                                <button @onclick="() => UpdateStatus(ticket.Id, OrderStatus.Cooking)"
                                        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-xl text-sm transition">
                                    Mulai Buat
                                </button>
                            }
                            else
                            {
                                <button @onclick="() => UpdateStatus(ticket.Id, OrderStatus.Completed)"
                                        class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2 rounded-xl text-sm transition">
                                    Selesai & Siap ✅
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

@code {
    private List<OrderTicket> activeOrders = new();

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        activeOrders = KitchenService.GetActiveTickets();
    }

    private void UpdateStatus(Guid ticketId, OrderStatus newStatus)
    {
        KitchenService.UpdateTicketStatus(ticketId, newStatus);
        LoadOrders();
    }
}